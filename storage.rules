rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Health Record Attachments ────────────────────────────
    // Patients, doctors, and staff can upload files to their own path.
    // Anyone authenticated can read (needed to display images in app).
    match /health_records/{patientId}/{fileName} {
      // Read: any authenticated user (URLs are specific — not enumerable)
      allow read: if request.auth != null;

      // Write: only the patient themselves, or staff/admin
      allow write: if request.auth != null && (
        request.auth.uid == patientId ||
        // Staff/admin check — simplified: any authenticated user can upload
        // for now; in production scope to only staff UIDs
        request.auth != null
      );

      // File size limit: 20MB
      allow write: if request.auth != null &&
        request.resource.size < 20 * 1024 * 1024 &&
        (
          // Images
          request.resource.contentType.matches('image/.*') ||
          // PDFs
          request.resource.contentType == 'application/pdf' ||
          // Word docs
          request.resource.contentType.matches('application/.*word.*') ||
          request.resource.contentType.matches('application/.*document.*')
        );
    }

    // ── Profile pictures (future use) ───────────────────────
    match /profile_pictures/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
